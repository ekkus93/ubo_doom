# Doom service config for the Ubo core process
export UBO_DOOM_LIB="$HOME/doom/libubodoom.so"
export UBO_DOOM_IWAD="$HOME/doom/doom2.wad"
export UBO_DOOM_FPS="30"
export UBO_DOOM_RENDER_FPS="15"

# Optional ALSA PCM device. Native fallback order also includes default,
# sysdefault:CARD=wm8960soundcard, plughw:CARD=wm8960soundcard,DEV=0,
# plughw:0,0, and hw:0,0.
export UBO_DOOM_ALSA_DEVICE="default"

# Optional stable runtime and config paths.
export UBO_DOOM_CWD="$HOME/doom"
export UBO_DOOM_CONFIG="$HOME/doom/doomrc.cfg"
